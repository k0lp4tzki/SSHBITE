# /home/sshbite/.ssh/authorized_keys (root:root 0644). One line per key, choose the variant for this host.
# <AUDIT-PUBLIC-KEY> = content of /etc/sshbite/audit_ed25519.pub
# (A) entry host: login only from the scanner, forwarding only to SSH ports (add permitopen="*:<PORT>" per extra SSH port)
restrict,port-forwarding,permitopen="*:22",from="<SCANNER-IP>",command="{gate_path}" <AUDIT-PUBLIC-KEY>
# (B) every other host: login only from the entry host, no forwarding
restrict,from="<ENTRY-HOST-IP>",command="{gate_path}" <AUDIT-PUBLIC-KEY>
# (C) only for crawl.chain_fallback: intermediate hops, from = previous hop
restrict,port-forwarding,permitopen="*:22",from="<PREVIOUS-HOP-IP>",command="{gate_path}" <AUDIT-PUBLIC-KEY>
